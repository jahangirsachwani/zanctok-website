# ---------- Zanctok website — Apache settings (GoDaddy cPanel) ----------
Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.zanctok.com%{REQUEST_URI} [L,R=301]

  # Old page addresses -> new pages (keeps Google rankings and old links working)
  RewriteRule ^masterpage\.html$            /index.html          [L,R=301]
  RewriteRule ^Certifications\.html$        /certifications.html [L,R=301]
  RewriteRule ^cgmp-compliance\.html$       /quality.html#cgmp   [L,R=301,NE]
  RewriteRule ^QualityOperation\.html$      /quality.html#operations [L,R=301,NE]
  RewriteRule ^QC-Department\.html$         /quality.html#qc     [L,R=301,NE]
  RewriteRule ^QA-Department\.html$         /quality.html#qa     [L,R=301,NE]
  RewriteRule ^Our-Facilities\.html$        /manufacturing.html  [L,R=301]
  RewriteRule ^Distribution-Net\.html$      /distribution.html   [L,R=301]
  RewriteRule ^Products\.html$              /products.html       [L,R=301]
  RewriteRule ^Contact\.php$                /contact.html        [L,R=301]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/gif "access plus 6 months"
</IfModule>
